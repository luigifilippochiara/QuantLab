# Secrets: never commit real API keys (.env.example is the committed template)
.env

# Run records, plan cache and the monitoring event log are local, per machine.
runs/

# Evaluation reports are timestamped outputs; regenerate with `quantlab.cli eval`.
planner_eval/reports/*
!planner_eval/reports/.gitkeep

# NOTE: data/snapshots/*.csv IS committed on purpose, so every run is reproducible
# from a clean clone without network access (see data/README.md).

# Python / uv
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Notebooks and tooling
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
.DS_Store
