# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# Everything works without a key: the app, CLI and notebooks fall back to mock mode.

# Used by the planner and narrator LLM calls (live / cached modes).
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown).
# QUANTLAB_PLANNER_MODEL=claude-sonnet-5-5
# QUANTLAB_NARRATOR_MODEL=claude-sonnet-5-5
# QUANTLAB_LLM_MODE=mock          # live | cached | mock (default: cached with a key, mock without)
# QUANTLAB_DATA_DIR=./data
# QUANTLAB_RUNS_DIR=./runs
# QUANTLAB_MAX_STEPS=15
# QUANTLAB_MAX_DATASETS=5
