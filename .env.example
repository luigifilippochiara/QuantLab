# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# Everything works without a key: the app, CLI and notebooks fall back to mock mode.

# Which LLM API live/cached mode calls: openai (default) or anthropic.
QUANTLAB_LLM_PROVIDER=openai

# The key of the provider above.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown).
# QUANTLAB_PLANNER_MODEL=gpt-6-luna       # anthropic default: claude-sonnet-5-5
# QUANTLAB_NARRATOR_MODEL=gpt-6-luna      # default: same as the planner
# QUANTLAB_PLANNER_EFFORT=medium          # reasoning effort: low | medium | high
# QUANTLAB_NARRATOR_EFFORT=low
# QUANTLAB_LLM_MODE=cached                # live | cached | mock (default: cached with a key, mock without)
# QUANTLAB_DATA_DIR=./data
# QUANTLAB_RUNS_DIR=./runs
# QUANTLAB_MAX_STEPS=15
